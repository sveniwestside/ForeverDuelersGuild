# Copy this file to .env in this directory. Keep credentials local.
# npm start / npm run manage read .env; it is excluded from source control.
HOST=127.0.0.1
PORT=8787

# Administrator-asserted Forever rule version for imports and calibration.
# Stored permanently in this database; use another DB_PATH for another ruleset.
FD_RULESET_ID=forever-v1

# This project's game. Forever API coverage is not officially verified yet.
# The default deliberately makes no guessed character API requests.
BLIZZARD_GAME=forever
BLIZZARD_LOCALE=en_GB

# Obtain these from your own Battle.net Developer Portal API client.
# Do not paste the secret into chat or into browser-side JavaScript.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
